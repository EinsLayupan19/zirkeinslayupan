# Copy this file to .env.local and paste your key after the = sign. .env.local is git-ignored.
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional. Defaults to gemini-3.5-flash-lite.
GEMINI_MODEL=

# Contact form: emails you through Resend (https://resend.com). Sign up with the address that should receive
# the messages, then create an API key and paste it here.
RESEND_API_KEY=
# Optional. Where messages go. Defaults to links.email in src/data.ts.
CONTACT_TO=
